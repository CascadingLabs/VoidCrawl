# Copy to docker/.env and edit. Compose reads it automatically.

# Pull a published image instead of building locally.
#VOIDCRAWL_IMAGE=ghcr.io/cascadinglabs/voidcrawl:headful-latest

# Browser/output count and deterministic local CDP ports (base + browser - 1).
BROWSER_COUNT=2
CDP_PORT_BASE=19222

# Display resolution shared by generated Sway outputs.
VNC_WIDTH=1920
VNC_HEIGHT=1080

# The noVNC viewer is disabled unless explicitly enabled. `docker/viewer.sh
# open --browser 1 --ttl 15m` starts the one loopback listener on demand.
VIEWER_MODE=disabled
VIEWER_NOVNC_PORT=6080
VIEWER_TTL=15m
VIEWER_MAX_FPS=30
# Internal, loopback-only wayvnc backend ports. Never published by Compose.
VNC_PORT_BASE=5900

# GPU hosts: set this to the host render node's numeric group ID so UID 10001
# can use /dev/dri without the container changing groups at runtime.
#HOST_RENDER_GID=107

# Chrome profiles are ephemeral by default. To persist them, set this to
# /profiles only after the named volume is owned by UID:GID 10001:10001.
#CHROME_PROFILES_DIR=/profiles

# Which GPU profile to use for compose-native invocations.
#COMPOSE_PROFILES=amd
